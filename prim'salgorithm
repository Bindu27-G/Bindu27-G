// Online C compiler to run C program online
#include <stdio.h>
#include<stdlib.h>
void prins(int a[10][10],int n)
{
    int i,j,ne=1,u,v,mincost=0,min,x,y,visited[10];
    for(i=1;i<=n;i++)
    visited[i]=0;
    visited[1]=1;
    printf("\n the edges considered are\n");
    while(ne<n)
    {
        for(i=1,min=999;i<=n;i++)
        for(j=1;j<=n;j++)
        if(a[i][j]<min)
        {
            if(visited[i]!=0)
            {
                min=a[i][j];
                x=u=i;
                y=v=j;
            }
        }
        if (visited[u]==0 || visited[v]==0)
        {
            printf("\n edges %d,(%d,%d)=%d",ne++,x,y,min);
            mincost=mincost+min;
            visited[y]=1;
        }
        a[x][y]=a[y][x]=999;
    }
    printf("\n the cost of MST is %d",mincost);
}

int main()
{
    int n,i,j,a[10][10];
    printf("+\n read no. of vertices:");
    scanf("%d",&n);
    printf("\n read the cost matrix\n");
    for(i=1;i<=n;i++)
    {
        for(j=1;j<=n;j++)
        {
            scanf("%d",&a[i][j]);
            if(a[i][j]==0)
            a[i][j]=999;
        }
    }
    prins(a,n);
    return 0;
}
